# Copy to .env.local for local app only. Local values come from `npx supabase status`.
# Keep local/private-test/production resources and credentials separate; never share setup secrets.
# All values below are server-only. Do not add NEXT_PUBLIC_ credentials.
# SMTP belongs to the Auth provider, not this app. No-send preflight uses separate process env.
# See docs/OPERATIONS.md; never commit status JSON, passwords, keys, or database dumps.
SUPABASE_URL=http://127.0.0.1:55431
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STOCKOS_SETUP_SECRET=
STOCKOS_APP_URL=http://localhost:3000
