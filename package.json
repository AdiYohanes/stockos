{
  "name": "stockos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-barcode-wasm.mjs",
    "prebuild": "node scripts/prepare-barcode-wasm.mjs",
    "check:barcode": "node --experimental-strip-types scripts/check-barcode-scanner.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false --pretty false",
    "check:domain": "node scripts/check-domain-stores.cjs",
    "check:deletion": "node --experimental-strip-types scripts/check-product-deletion.mjs",
    "check:dashboard": "node scripts/check-dashboard-metrics.cjs",
    "check:catalog": "node scripts/check-warung-catalog.mjs",
    "check:smtp": "node scripts/check-smtp-readiness.mjs --self-test",
    "check:reports": "node scripts/check-reports.mjs",
    "check:proof": "python -I scripts/launch-hardening-proof.py --self-test",
    "check:settings": "node scripts/check-settings-state.mjs",
    "check:seeder": "node scripts/check-seeder-safety.mjs",
    "check:operations": "node scripts/check-operations.mjs --self-test",
    "check": "npm run check:barcode && npm run check:domain && npm run check:deletion && npm run check:dashboard && npm run check:catalog && npm run check:smtp && npm run check:reports && npm run check:proof && npm run check:settings && npm run check:seeder && npm run check:operations"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@iconify/react": "^6.0.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
